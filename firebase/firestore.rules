rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function signedIn() { return request.auth != null; }
    // Staff get a role claim from the seed script / API. No claim = borrower (self sign-up).
    function role() { return request.auth.token.get('role', 'borrower'); }
    function isRole(r) { return signedIn() && role() == r; }
    function uid() { return request.auth.uid; }
    function appData(appId) {
      return get(/databases/$(database)/documents/applications/$(appId)).data;
    }
    function canViewApp(appId) {
      return isRole('underwriter')
        || (isRole('borrower') && appData(appId).borrowerId == uid())
        || (isRole('broker') && appData(appId).brokerId == uid());
    }
    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ---------- Users ----------
    match /users/{userId} {
      allow read: if signedIn() && (
        uid() == userId
        || isRole('underwriter')
        || (isRole('broker') && resource.data.assignedBrokerId == uid())
      );
      // Self-signup is borrower only; brokers are created by underwriters via the API,
      // underwriters by the seed script
      allow create: if signedIn() && uid() == userId
        && request.resource.data.role == 'borrower';
      allow update: if signedIn() && uid() == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['role', 'assignedBrokerId']);
    }

    // ---------- Applications ----------
    match /applications/{appId} {
      allow read: if isRole('underwriter')
        || (isRole('borrower') && resource.data.borrowerId == uid())
        || (isRole('broker') && resource.data.brokerId == uid());

      // All writes go through the API (Admin SDK), which bypasses these rules
      allow write: if false;

      match /agentLogs/{logId} {
        allow read: if isRole('underwriter')
          || (isRole('broker') && appData(appId).brokerId == uid());
        allow write: if false;   // backend (Admin SDK) only
      }

      match /documents/{docId} {
        allow read: if canViewApp(appId);
        allow create: if canViewApp(appId)
          && request.resource.data.uploadedBy == uid();
      }

      match /messages/{msgId} {
        allow read: if canViewApp(appId);
        allow create: if canViewApp(appId)
          && request.resource.data.senderId == uid();
      }
    }

    // ---------- Payments (written by backend after Stripe/PayPal confirms) ----------
    match /payments/{paymentId} {
      allow read: if isRole('underwriter') || (signedIn() && resource.data.userId == uid());
      allow write: if false;
    }

    // ---------- Reviews ----------
    match /reviews/{reviewId} {
      allow create: if isRole('borrower') && request.resource.data.userId == uid();
      allow read: if isRole('underwriter') || (signedIn() && resource.data.userId == uid());
    }

    // ---------- Support tickets ----------
    match /supportTickets/{ticketId} {
      allow create: if isRole('borrower') && request.resource.data.userId == uid();
      allow read: if isRole('underwriter') || (signedIn() && resource.data.userId == uid());
      allow update: if isRole('underwriter') && changedOnly(['status']);
    }

    // ---------- Valuation checks (written by API after running the model) ----------
    match /valuationChecks/{checkId} {
      allow read: if isRole('underwriter') || (signedIn() && resource.data.userId == uid());
      allow write: if false;
    }

    // ---------- Stress tests (written by API after running the simulation) ----------
    match /stressTests/{testId} {
      allow read: if isRole('underwriter');
      allow write: if false;
    }
  }
}